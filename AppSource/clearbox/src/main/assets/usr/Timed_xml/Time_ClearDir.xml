cat <<w
<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>$L_AR_CUST_TIME ($L_UNIT: $L_TIME_M)</title>
        <summary sh="echo -n '$L_NUM_TIME_NOW '; grep 'time=' $work_dir/$timed_config_dir/ClearDir.conf | cut -f2 -d '='" />
        <param name="minute_num" max="59" min="1" type="seekbar" value="10" />
            <set>
            echo -e "time=${minute_num}/M\ndate=0\nrun=$home_dir/$core --clear-storage" > "$work_dir/$timed_config_dir/ClearDir.conf"
            echo " » $L_OPEND! "
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false" >
        <title>$L_CLOSE_FUNCTION</title>
            <set>
            rm "$work_dir/$timed_config_dir/ClearDir.conf"
            echo " » $L_CLOSED! "
            </set>
    </action>
</group>
<!-- END -->
w
