cat <<w
<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>$L_AR_CUST_TIME ($L_UNIT: $L_TIME_D)</title>
        <summary sh="echo -n '$L_NUM_TIME_NOW '; grep 'time=' $work_dir/$timed_config_dir/ClearAll.conf | cut -f2 -d '='" />
        <param name="day_num" max="30" min="1" type="seekbar" value="3" />
            <set>
            echo -e "time=\${day_num}/D\ndate=0\nrun=$home_dir/$core --clear-all\nin=0/5" > "$work_dir/$timed_config_dir/ClearAll.conf"
            echo " » $L_OPEND! "
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false" >
        <title>$L_CLOSE_FUNCTION</title>
            <set>
            rm "$work_dir/$timed_config_dir/ClearAll.conf"
            echo " » $L_CLOSED! "
            </set>
    </action>
</group>
<!-- END -->
w
