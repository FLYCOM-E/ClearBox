cat <<w
<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false">
        <title>BACKUP</title>
            <set>
            "$home_dir/$core" "--config" backup
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>RECOVER</title>
        <param name="config" label="File" type="file" editable="true" />
            <set>
            "$home_dir/$core" "--config" recovery "$config"
            </set>
    </action>
</group>
<!-- END -->
w
