<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>Настройка интервала (в часах)</title>
        <summary sh="echo -n 'Текущее время: '; grep 'time=' $work_dir/$timed_config_dir/ListDir.conf | cut -f2 -d '='" />
        <param name="hour_num" max="23" min="1" title="Выберите время ползунком (в часах)" type="seekbar" value="12" />
            <set>
            echo -e "time=${hour_num}/H\ndate=0\nrun=$home_dir/$core --clear-storage-cust" > "$work_dir/$timed_config_dir/ListDir.conf"
            echo " » Установлено успешно!"
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false" >
        <title>Отключить эту функцию</title>
            <set>
            rm "$work_dir/$timed_config_dir/ListDir.conf"
            echo " » Отключено!"
            </set>
    </action>
</group>
<!-- END -->
