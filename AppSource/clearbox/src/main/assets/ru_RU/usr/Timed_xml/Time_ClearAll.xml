<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>Настройка интервала (в днях)</title>
        <summary sh="echo -n 'Текущее время: '; grep 'time=' $work_dir/$timed_config_dir/ClearAll.conf | cut -f2 -d '='" />
        <param name="day_num" max="30" min="1" title="Выберите время, перетаскивая ползунок (в днях)" type="seekbar" value="3" />
            <set>
            echo -e "time=${day_num}/D\ndate=0\nrun=$home_dir/$core --clear-all\nin=0/5" > "$work_dir/$timed_config_dir/ClearAll.conf"
            echo " » Установлено успешно!"
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false" >
        <title>Отключить функцию</title>
            <set>
            rm "$work_dir/$timed_config_dir/ClearAll.conf"
            echo " » Отключено!"
            </set>
    </action>
</group>
<!-- END -->
