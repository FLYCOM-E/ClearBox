<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>Настройка интервала (в минутах)</title>
        <summary sh="echo -n 'Текущее время: '; grep 'time=' $work_dir/$timed_config_dir/ClearDir.conf | cut -f2 -d '='" />
        <param name="minute_num" max="59" min="1" title="Выберите время (в минутах)" type="seekbar" value="10" />
            <set>
            echo -e "time=${minute_num}/M\ndate=0\nrun=$home_dir/$core --clear-storage" > "$work_dir/$timed_config_dir/ClearDir.conf"
            echo " » Установлено успешно!"
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false" >
        <title>Отключить эту функцию</title>
            <set>
            rm "$work_dir/$timed_config_dir/ClearDir.conf"
            echo " » Отключено!"
            </set>
    </action>
</group>
<!-- END -->
