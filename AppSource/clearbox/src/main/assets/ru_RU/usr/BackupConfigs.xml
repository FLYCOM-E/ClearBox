<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title="Резервное копирование конфигурации">
    <action interruptible="false" auto-off="false">
        <title>Резервное копирование</title>
            <set>
            "$home_dir/$core" "--config" backup
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title="Восстановление конфигурации">
    <action interruptible="false">
        <title>Восстановить</title>
        <param name="config" label="Выбор файла" type="file" editable="true" />
            <set>
            "$home_dir/$core" "--config" recovery "$config"
            </set>
    </action>
</group>
<!-- END -->