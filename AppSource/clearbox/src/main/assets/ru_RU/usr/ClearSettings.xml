<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <pages>
        <page title="Настройки внешнего хранилища" config-sh="cat CardSettings.xml"/>
    </pages>
</group>
<!-- END -->
<!-- START -->
<group title="">
    <switch>
        <title>Выполнять классификацию файлов при автоматической очистке (один клик/по расписанию)</title>
            <get>
            if grep "clearbox_auto_file_all=1" "$work_dir/settings.prop" >/dev/null; then
                echo 1
            else
                echo 0
            fi
            </get>
            <set>
            if grep "clearbox_auto_file_all=0" "$work_dir/settings.prop" >/dev/null; then
                sed -i 's/clearbox_auto_file_all=0/clearbox_auto_file_all=1/g' "$work_dir/settings.prop"
                echo " » Включено!"
            else
                sed -i 's/clearbox_auto_file_all=1/clearbox_auto_file_all=0/g' "$work_dir/settings.prop"
                echo " » Отключено!"
            fi
            </set>
    </switch>
</group>
<!-- END -->
<!-- START -->
<group title="">
    <switch>
        <title>Выполнять быструю оптимизацию диска при автоматической очистке (один клик/по расписанию)</title>
            <get>
            if grep "clearbox_auto_fast_gc=1" "$work_dir/settings.prop" >/dev/null; then
                echo 1
            else
                echo 0
            fi
            </get>
            <set>
            if grep "clearbox_auto_fast_gc=0" "$work_dir/settings.prop" >/dev/null; then
                sed -i 's/clearbox_auto_fast_gc=0/clearbox_auto_fast_gc=1/g' "$work_dir/settings.prop"
                echo " » Включено!"
            else
                sed -i 's/clearbox_auto_fast_gc=1/clearbox_auto_fast_gc=0/g' "$work_dir/settings.prop"
                echo " » Отключено!"
            fi
            </set>
    </switch>
</group>
<!-- END -->
<!-- START -->
<group title="Белый список очистки кэша">
    <action interruptible="false" auto-off="false" >
        <title>Добавить в белый список очистки</title>
        <desc>Выберите приложения</desc>
            <set>
            . ./add_ClearCacheWhitelist.sh
            </set>
        <param name="Package" type="app" multiple="true" separator=" " options-sh="pm list package -3 | cut -f2 -d ':' | grep -vxFf $work_dir/ClearWhitelist.prop" />
    </action>
    <action interruptible="false" auto-off="false" >
        <title>Удалить из белого списка</title>
        <desc>Выберите приложения</desc>
            <set>
            . ./rm_ClearCacheWhitelist.sh
            </set>
        <param name="Package" type="app" multiple="true" separator=" " options-sh="cat $work_dir/ClearWhitelist.prop" />
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>Пропускать кэш размером (МБ)</title>
        <summary sh="echo -n 'Текущий размер: '; echo -n $(grep clearbox_clear_cache_size $work_dir/settings.prop | cut -f2 -d '='); echo -n ' МБ'" />
        <param name="put" label="Единица: МБ" required="required" type="int" />
            <set>
            sed -i 's/clearbox_clear_cache_size=[0-9]*/clearbox_clear_cache_size='"$put"'/g' "$work_dir/settings.prop"
            echo " » Установлено успешно!"
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action>
        <title>Пользовательский каталог для классификации файлов</title>
        <summary sh="echo -n 'Текущий каталог: '; echo -n $(grep clearbox_file_all_dirname $work_dir/settings.prop | cut -f2 -d '=')" />
        <param name="path" type="folder" value="Documents" editable="true" />
            <set>
            sed -i 's|clearbox_file_all_dirname=.*|clearbox_file_all_dirname='"$path"'|g' "$work_dir/settings.prop"
            echo " » Установлено успешно!"
            </set>
    </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false">
        <title>Минимальный порог для F2FS GC</title>
        <summary sh="echo -n 'Текущее значение: '; grep clearbox_f2fs_gc_min_dirty $work_dir/settings.prop | cut -f2 -d '='" />
        <param name="put" label="Число" required="required" type="int" />
            <set>
            sed -i 's/clearbox_f2fs_gc_min_dirty=[0-9]*/clearbox_f2fs_gc_min_dirty='"$put"'/g' "$work_dir/settings.prop"
            echo " » Установлено успешно!"
            </set>
    </action>
</group>
<!-- END -->
