cat <<w
<?xml version="1.0" encoding="utf-8"?>
<!-- START -->
<group title=" ">
    <pages>
        <page title="Управление модулем" config-sh="cat Settings.xml" />
    </pages>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <action interruptible="false" auto-off="false" id="001">
        <title>Оптимизация и очистка в один клик</title>
            <set>
            "$home_dir/$core" "--clear-all"
            </set>
    </action>
    <action interruptible="false" auto-off="false" id="002">
        <title>Очистка пользовательских каталогов</title>
            <set>
            "$home_dir/$core" "--clear-storage-cust"
            </set>
    </action>
    <action interruptible="false" auto-off="false" id="003">
        <title>Очистка мусорных файлов и пустых папок</title>
            <set>
            "$home_dir/$core" "--clear-storage"
            </set>
    </action>
    <action interruptible="false" auto-off="false" id="004">
        <title>Очистка кэша всех приложений</title>
            <set>
            "$home_dir/$core" "--clear-app-cache"
            </set>
    </action>
    <action warning="Сортировка файлов во внутреннем/внешнем хранилище по правилам. Каталог хранения: папка Document в соответствующем каталоге" interruptible="false" shell="default" auto-off="false" auto-finish="false" id="005">
        <title>Магнит (сортировка файлов)</title>
            <set>
            "$home_dir/$core" "--file-sort"
            </set>
    </action>
    <page
        config-sh="Print_FileClearXml.sh"
        desc="Эта страница динамически строится на основе конфигурационных файлов очистки"
        title="Глубокая очистка файлов" />
    <page
        config-sh="Print_AppClearXml.sh"
        desc="Эта страница динамически строится на основе файлов правил"
        title="Очистка по правилам для приложений" />
        <action shell="default" warning="Очистка системного кэша, необходимого для работы. Подходит при странных ошибках или после крупных изменений. После очистки система автоматически пересоздаст кэш. Эта операция не повышает производительность и не освобождает значительное место. Если вы не уверены, не используйте. После очистки рекомендуется перезагрузка." interruptible="false" auto-off="false" auto-finish="false" id="006">
            <title>Очистка системного кэша</title>
                <set>
                "$home_dir/$core" "--clear-system-cache"
                </set>
        </action>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <pages>
        <page title="Автоочистка" config-sh="cat Timed_ProSettings.xml" />
    </pages>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <switch>
        <title>Привязка каталога правил (перенаправление)</title>
            <get>
            if grep "clearbox_bind_path=1" "$work_dir/settings.prop" >/dev/null; then
                echo 1
            else
                echo 0
            fi
            </get>
            <set>
            if grep "clearbox_bind_path=0" "$work_dir/settings.prop" >/dev/null; then
                if "$home_dir/$core" "--storage-bind-custom" "MOUNT"; then
                    sed -i 's/clearbox_bind_path=0/clearbox_bind_path=1/g' "$work_dir/settings.prop"
                fi
                echo " » Включено ~"
            else
                if "$home_dir/$core" "--storage-bind-custom" "UMOUNT"; then
                    sed -i 's/clearbox_bind_path=1/clearbox_bind_path=0/g' "$work_dir/settings.prop"
                fi
                echo " » Отключено ~"
            fi
            </set>
    </switch>
</group>
<!-- END -->
<!-- START -->
<group title="">
    <switch>
        <title>Фиксация внутреннего хранилища</title>
            <get>
            if grep "clearbox_stop_storage=1" "$work_dir/settings.prop" >/dev/null; then
                echo 1
            else
                echo 0
            fi
            </get>
            <set>
            if grep "clearbox_stop_storage=0" "$work_dir/settings.prop" >/dev/null; then
                "$home_dir/$core" "--storage-lock" STOP
            else
                "$home_dir/$core" "--storage-lock" RESET
            fi
            </set>
    </switch>
</group>
<!-- END -->
<!-- START -->
<group title=" ">
    <pages>
        <page title="Оптимизация системы" config-sh="cat system_plus.xml" />
    </pages>
</group>
<!-- END -->
<!-- START -->
<group title="">
    <pages>
        <page title="Специальные функции" config-sh="cat Other.xml" />
    </pages>
</group>
<!-- END -->
w
